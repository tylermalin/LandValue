# =============================================================================
# Land Value Engine (LVE-LAP) — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
# `.env` is git-ignored and must NEVER be committed (it holds credentials).
# =============================================================================

# --- Apify property ingestion (optional) ---
# Get a token at https://console.apify.com/account/integrations
# Actor tradeoffs (as of this build):
#   memo23~landwatch-scraper   -> has lat/lon + APN + address (best), PAID rental (~$30-45/mo)
#   crawlerbros~us-land-scraper -> cheap pay-per-result, but NO coordinates
#   rigelbytes~landdotcom-scraper -> currently broken (403 from Land.com)
# Live runs cost money. URL-based actors read SEARCH_URLS + MAX_ITEMS below.
#
# FREE alternative (no scraper): curate parcels in a CSV and let the engine
# resolve coordinates from public GIS by APN/address:
#   python master_engine.py --parcels-file data/sample_parcels.csv
APIFY_API_TOKEN=your_apify_token_here
PROPERTY_SCRAPER_ACTOR_ID=memo23~landwatch-scraper

# --- Latent Arbitrage execution thresholds ---
MAX_PRICE_PER_ACRE=2000.0
MIN_TRANSMISSION_BUFFER_MILES=3.0
MIN_SUBSTATION_HEADROOM_MW=10.0
DAYS_ON_MARKET_THRESHOLD=90

# --- Regional pricing baseline (used by the price-arbitrage scorer) ---
# Regional fair-market $/acre used as the contrast point for arbitrage.
REGIONAL_BASELINE_PRICE_PER_ACRE=6000.0

# --- Resource optionality ---
# Parcels within this many miles of a USGS-mapped waterbody earn a
# resource-optionality bonus. Set 0 to disable the surface-water signal.
SURFACE_WATER_BONUS_MILES=5.0

# --- Run mode ---
# When APIFY_API_TOKEN is unset/placeholder, the engine falls back to mock
# parcels so the pipeline is runnable end-to-end. Force it explicitly here.
# Values: auto | mock | live
RUN_MODE=auto

# --- Target corridor (comma-separated) ---
TARGET_STATES=NV,AZ,UT,NM
TARGET_ZIPS=89013,86021,84034,88310
